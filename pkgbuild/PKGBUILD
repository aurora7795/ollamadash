pkgname=ollamadash
pkgver=0.2.0
pkgrel=1
pkgdesc='Live dashboard for a local Ollama server'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/ollamadash "$pkgdir/usr/bin/ollamadash"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$startdir/ollamadash.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ollamadash.svg"
  install -Dm644 "$startdir/ollamadash.desktop" "$pkgdir/usr/share/applications/ollamadash.desktop"
}
