# Maintainer: aurora7795 <2437625+aurora7795@users.noreply.github.com>
pkgname=ollamadash
pkgver=0.1.3
pkgrel=1
pkgdesc='Live Qt dashboard for a local or remote Ollama server, themed for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/aurora7795/ollamadash'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('675d50c0ea24ec4e5a36bc7b2d27b7cd57900d73d872c41d9d8eced1ea1c91c3')

build() {
  cd "$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/ollamadash "$pkgdir/usr/bin/ollamadash"
  install -Dm644 pkgbuild/ollamadash.desktop "$pkgdir/usr/share/applications/ollamadash.desktop"
  install -Dm644 pkgbuild/ollamadash.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ollamadash.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
